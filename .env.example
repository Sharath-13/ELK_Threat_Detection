# ==============================================================================
# Centralized Log Monitoring and Threat Detection System using ELK Stack
# Project Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Elastic Stack Version
# ------------------------------------------------------------------------------
STACK_VERSION=8.11.3

# ------------------------------------------------------------------------------
# 2. Cluster Security & Authentication Credentials
# ------------------------------------------------------------------------------
# Primary superuser account ('elastic')
ELASTIC_PASSWORD=REPLACE_WITH_YOUR_OWN_PASSWORD
KIBANA_PASSWORD=REPLACE_WITH_YOUR_OWN_PASSWORD
LOGSTASH_INTERNAL_PASSWORD=REPLACE_WITH_YOUR_OWN_PASSWORD
# ------------------------------------------------------------------------------
# 3. Java Virtual Machine (JVM) & Node.js Memory Settings (Tuned for 8 GB RAM Host)
# ------------------------------------------------------------------------------
# Elasticsearch JVM Heap: 1 GB minimum / maximum
ES_JAVA_OPTS=-Xms1024m -Xmx1024m

# Logstash JVM Heap: 512 MB minimum / maximum
LS_JAVA_OPTS=-Xms512m -Xmx512m

# Kibana Node.js runtime memory cap
NODE_OPTIONS=--max-old-space-size=512

# ------------------------------------------------------------------------------
# 4. Docker Container Resource Limits
# ------------------------------------------------------------------------------
ES_MEM_LIMIT=1800m
LS_MEM_LIMIT=1024m
KIBANA_MEM_LIMIT=800m

# ------------------------------------------------------------------------------
# 5. Network Port Bindings
# ------------------------------------------------------------------------------
# Elasticsearch: Bound strictly to localhost loopback for zero-trust security
ES_PORT=127.0.0.1:9200

# Kibana: Web UI and analytics portal
KIBANA_PORT=127.0.0.1:5601

# Logstash: Ingestion port for Beats (Winlogbeat & Filebeat)
LOGSTASH_PORT=5044

# ------------------------------------------------------------------------------
# 6. Kibana encryption keys (required for sessions, Alerting, and Reporting)
# ------------------------------------------------------------------------------
# Each value must be at least 32 characters. Set real values in .env only.
# Generate locally, for example: [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
XPACK_SECURITY_ENCRYPTIONKEY=replace_with_unique_32plus_char_key
XPACK_ENCRYPTEDSAVEDOBJECTS_ENCRYPTIONKEY=replace_with_unique_32plus_char_key
XPACK_REPORTING_ENCRYPTIONKEY=replace_with_unique_32plus_char_key
